<form autocomplete="off">
    <div class="form-group">
        <label>Show FSA Vehicle Sheet Buttons</label>
        <input type="checkbox" name="vehicleSheetToolsEnabled" {{checked vehicleSheetToolsEnabled}}>
        <p class="notes">Show Long Rest, Registration, Chat Loadout, and Fuel Release controls on owned vehicle sheets.</p>
    </div>

    <hr>

    <p class="notes">These buttons are inserted into the vehicle sheet sidebar near the TradeHub sheet controls when present.</p>

    <button type="submit">
        <i class="fas fa-save"></i> Save
    </button>
</form>
