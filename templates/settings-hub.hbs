<form class="fsa-settings-hub" autocomplete="off">
    <header>
        <h2>Full Speed Ahead</h2>
        <p class="notes">Configure the bundled ship movement, QuickTarget, vehicle combat, and sheet presentation tools.</p>
    </header>

    <div class="fsa-settings-grid">
        <button type="button" data-open-fsa-settings="effects">
            <i class="fas fa-cog"></i>
            <span>Configure, Sound, Thrust, Rotate</span>
        </button>

        <button type="button" data-open-fsa-settings="combat">
            <i class="fas fa-users-cog"></i>
            <span>Vehicle Combat Encounters</span>
        </button>

        <button type="button" data-open-fsa-settings="sheet-buttons">
            <i class="fas fa-list-check"></i>
            <span>Vehicle Sheet Buttons</span>
        </button>

        <button type="button" data-open-fsa-settings="quicktarget">
            <i class="fas fa-crosshairs"></i>
            <span>QuickTarget Settings</span>
        </button>

        <button type="button" data-open-fsa-settings="cosmetics">
            <i class="fas fa-paint-brush"></i>
            <span>Vehicle Sheet Cosmetics</span>
        </button>
    </div>
</form>
